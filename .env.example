# 飞书应用凭据（必填）
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# 默认接收者 open_id（可选）
FEISHU_RECEIVE_ID=ou_xxx

# STT 模型路径（使用 STT 时必填）
SHERPA_ONNX_MODEL_DIR=/path/to/sherpa-onnx-paraformer-zh-small-2024-03-09

# TTS 引擎（可选，默认 edge）
# 可选值：edge, piper, mimo, auto
TTS_ENGINE=edge

# Edge TTS 语音（可选）
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# Piper TTS 模型路径（可选）
TTS_PIPER_MODEL=/path/to/piper/model.onnx

# MIMO TTS API URL（可选）
TTS_MIMO_URL=http://your-mimo-api/tts

# Voice I/O 脚本目录（可选，默认自动检测）
# VOICE_IO_DIR=/opt/feishu-voice-io
